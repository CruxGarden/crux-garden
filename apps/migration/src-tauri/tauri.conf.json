{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crux Garden Migration Tauri Preview",
  "version": "0.1.0",
  "identifier": "garden.crux.migration.tauri-preview",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Crux Garden Migration",
        "width": 1280,
        "height": 900,
        "minWidth": 480,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "resources": {
      "../runtime-dist/": "runtime/"
    },
    "category": "Utility",
    "shortDescription": "Bring your files home. Preserve and verify your exports.",
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ]
  }
}
